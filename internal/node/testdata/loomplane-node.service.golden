[Unit]
Description=Loomplane node
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=loomplane-node
ExecStart=/usr/local/lib/loomplane-node/loomctl node run --state-dir /var/lib/loomplane-node --root-allowlist
Restart=always
RestartSec=5
RestartPreventExitStatus=77
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/loomplane-node
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
