{"groups":["docker"],"package_update":true,"packages":["docker.io","python3","iproute2"],"runcmd":[["systemctl","enable","--now","docker"],["python3","/root/loomplane-enroll.py"]],"users":["default",{"groups":["docker"],"name":"loomplane","shell":"/bin/bash","ssh_authorized_keys":["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDtqJ7zOtqQtYqOo0CpvDXNlMhV3HeJDpjrASKGLWdop"]}],"write_files":[{"content":"#!/usr/bin/python3\nimport json, pathlib, time, urllib.request\nkey = pathlib.Path('/etc/ssh/ssh_host_ed25519_key.pub').read_text().strip()\nbody = json.dumps({'host_key': key}).encode()\nfor attempt in range(180):\n    try:\n        request = urllib.request.Request(\"https://enroll.example.com/api/v1/infrastructure/enroll/org/infraop_fixture\", data=body, headers={'Authorization': 'Bearer '+\"fixture-token\", 'Content-Type':'application/json'})\n        with urllib.request.urlopen(request, timeout=10) as response:\n            if response.status == 204:\n                pathlib.Path(__file__).unlink(missing_ok=True)\n                break\n    except Exception:\n        time.sleep(10)\n","path":"/root/loomplane-enroll.py","permissions":"0600"}]}