# Use a published release tag, or pin the digest from the release assets.
LOOMPLANE_IMAGE=ghcr.io/xraph/loomplane:v0.1.0
LOOMPLANE_DOMAIN=loomplane.example.com
ACME_EMAIL=ops@example.com

# Required. Generate these once and keep them in your secret manager.
# openssl rand -base64 32
LOOMPLANE_SECRET_KEY=
# openssl rand -hex 32 (hex avoids URL escaping in the database DSN)
POSTGRES_PASSWORD=

# Turns on the AI section.
LOOMPLANE_AI_ENABLED=false

# Optional GitHub App. Set all five credentials together.
LOOMPLANE_GITHUB_APP_ID=
LOOMPLANE_GITHUB_APP_SLUG=
LOOMPLANE_GITHUB_PRIVATE_KEY=
LOOMPLANE_GITHUB_CLIENT_ID=
LOOMPLANE_GITHUB_CLIENT_SECRET=
LOOMPLANE_GITHUB_WEBHOOK_SECRET=
# For GitHub Enterprise, set the API and web URLs for your server.
LOOMPLANE_GITHUB_API_URL=https://api.github.com
LOOMPLANE_GITHUB_WEB_URL=https://github.com

# Optional email delivery, including password resets. Set a Resend API key,
# or the SMTP settings below (which require implicit TLS), not both.
LOOMPLANE_NOTIFICATIONS_RESEND_API_KEY=
LOOMPLANE_NOTIFICATIONS_SMTP_HOST=
LOOMPLANE_NOTIFICATIONS_SMTP_PORT=465
LOOMPLANE_NOTIFICATIONS_SMTP_USERNAME=
LOOMPLANE_NOTIFICATIONS_SMTP_PASSWORD=
LOOMPLANE_NOTIFICATIONS_FROM=

# Optional independent recovery object storage (see docs/operations.md).
LOOMPLANE_BACKUP_URL=
LOOMPLANE_BACKUP_BUCKET=loomplane-backups

# How many repository analyses the worker runs at once. Each one can unpack
# up to 2 GiB of source into the analysis-work volume and needs memory on top
# of that. Raise this only with spare disk, and raise the worker's mem_limit
# in compose.yaml along with it.
LOOMPLANE_ANALYSIS_CONCURRENCY=2

# Comma-separated provider names to pause during an incident.
LOOMPLANE_PAUSED_PROVIDERS=

# true or false forces the sign-up waitlist on or off. Empty leaves it to the
# instance (see docs/operations.md).
LOOMPLANE_WAITLIST_ENABLED=
# Where platform admins open the console.
LOOMPLANE_CONSOLE_PATH=/__console

# You can pin these to reviewed digests. Keep PostgreSQL on major version 17.
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2-alpine
