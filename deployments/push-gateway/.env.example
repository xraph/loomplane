# Copy to .env next to compose.yaml. Secrets never go in this file: put the
# key files in secrets/ (see compose.yaml for the names).
PUSH_GATEWAY_IMAGE=ghcr.io/xraph/loomplane-push-gateway:v0.1.0
PUSH_GATEWAY_DOMAIN=push.loomplane.com
ACME_EMAIL=

# Handle sealing. The ID names the key in secrets/sealing-key. To rotate, move
# the old ID here and set a new current one; the old key stays accepted for
# 90 days.
PUSH_GATEWAY_SEALING_KEY_ID=k202611
PUSH_GATEWAY_PREVIOUS_SEALING_KEY_ID=

# iOS. Set both together and put the .p8 in secrets/apns-key.p8. To turn iOS
# off, unset both. Android works without them.
PUSH_GATEWAY_APNS_KEY_ID=
PUSH_GATEWAY_APNS_TEAM_ID=
# Only for your own app build, and only together with the two above. Left
# empty, the gateway uses com.loomplane.app.
PUSH_GATEWAY_APNS_BUNDLE_ID=

# Rate limits: sends per second per server key, and sends per minute per device.
PUSH_GATEWAY_SERVER_RATE=50
PUSH_GATEWAY_HANDLE_RATE=30

CADDY_IMAGE=caddy:2-alpine
