# Settings for loomplane.service and loomplane-worker.service.
#
# The packages install this as /etc/loomplane/loomplane.env, owned by root and
# readable by the loomplane group only, and leave your edits alone on upgrade.
# Every LOOMPLANE_ variable config.yaml reads can go here. Keep the values
# unquoted: systemd and sh both read this file.

# Required. Fill these in before the first start.
LOOMPLANE_ENVIRONMENT=production
# The https address people open, with no path. Your reverse proxy serves it.
LOOMPLANE_PUBLIC_URL=https://loomplane.example.com
# openssl rand -base64 32. Every stored credential is encrypted with it, so
# keep a copy in your secret manager and away from your backups.
LOOMPLANE_SECRET_KEY=
# postgres://USER:PASSWORD@HOST:5432/DATABASE. A hex password from
# openssl rand -hex 32 needs no escaping.
LOOMPLANE_DATABASE_URL=

# Where things are. These match the packages. After an archive install, point
# LOOMPLANE_DASHBOARD_DIR at /usr/local/share/loomplane/dashboard.
LOOMPLANE_CONFIG_DIR=/etc/loomplane
LOOMPLANE_DASHBOARD_DIR=/usr/share/loomplane/dashboard
LOOMPLANE_STORAGE_URL=file:///var/lib/loomplane
LOOMPLANE_ANALYSIS_WORK_DIR=/var/lib/loomplane-work

# Listen on loopback only. The reverse proxy in front reaches these, and
# nothing else should.
LOOMPLANE_HTTP_ADDR=127.0.0.1:8780
LOOMPLANE_WORKER_HTTP_ADDR=127.0.0.1:8781

# How many repository analyses the worker runs at once. Each can unpack up to
# 2 GiB of source into the work directory.
LOOMPLANE_ANALYSIS_CONCURRENCY=2

# Optional. Email for invitations and password resets: a Resend key, or SMTP
# with implicit TLS. Set one of them, not both.
#LOOMPLANE_NOTIFICATIONS_RESEND_API_KEY=
#LOOMPLANE_NOTIFICATIONS_SMTP_HOST=
#LOOMPLANE_NOTIFICATIONS_SMTP_PORT=465
#LOOMPLANE_NOTIFICATIONS_SMTP_USERNAME=
#LOOMPLANE_NOTIFICATIONS_SMTP_PASSWORD=
#LOOMPLANE_NOTIFICATIONS_FROM=

# Optional. Off-host recovery storage (S3).
#LOOMPLANE_BACKUP_URL=
#LOOMPLANE_BACKUP_BUCKET=loomplane-backups

# Optional. Turns on the AI section.
#LOOMPLANE_AI_ENABLED=false
