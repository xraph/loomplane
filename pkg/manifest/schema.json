{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomplane.dev/schemas/loomplane.json",
  "title": "loomplane.yaml",
  "description": "Application deployment intent. Version 1 keeps existing workflows; version 2 adds gated federation intent.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": [1, 2],
      "description": "Version 2 federation requires separate runtime qualification."
    },
    "defaults": {
      "description": "Apply to every service and resource that doesn't set its own. The default region only comes with the default provider.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "cloud_tags": {
          "description": "Select a Cloud target by tags for every service with no placement of its own. Can't be set with provider.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          }
        }
      }
    },
    "services": {
      "description": "What the application runs, by name.",
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    },
    "resources": {
      "description": "Backing services the application needs, such as Postgres, by name. A resource can't share a service's name.",
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    },
    "gateways": {
      "description": "Public entry points that route requests to services by path, by name. Loomplane builds each one on Bastion and runs it like a service. A gateway can't share a service's or resource's name.",
      "type": "object",
      "maxProperties": 10,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/gateway"
      }
    },
    "database_gateway": {
      "description": "Where the database gateway runs, for the Postgres resources that set gateway: true. Loomplane builds it and runs it like a service. Set provider, or select a Cloud target with cloud_tags, not both.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "cloud_tags": {
          "description": "Select the one target in the assigned Cloud that carries every tag. Can't be set with provider.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          }
        },
        "environments": {
          "description": "Overrides in one environment, by name.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "$ref": "#/$defs/provider"
              },
              "region": {
                "$ref": "#/$defs/region"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "not": {
        "required": ["provider", "cloud_tags"],
        "properties": {
          "cloud_tags": {
            "minItems": 1
          }
        }
      }
    },
    "links": {
      "description": "Private network links between two clouds, by name: an HA VPN between a Google Cloud project's default network and an AWS account's default VPC, so services on Google Cloud reach private services and databases on AWS. Each environment gets its own, billed by the hour on both clouds.",
      "type": "object",
      "maxProperties": 5,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/link"
      }
    },
    "ignore": {
      "description": "What repository analysis found that the application doesn't use.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "description": "Resource kinds, such as mysql.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/kind"
          }
        }
      }
    },
    "held": {
      "description": "How a plan that holds some repositories back treats their services, which keep running with the links they were deployed with.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "same_address": {
          "description": "What a plan does when a held service uses a Cloud Run service it creates again, after it was deleted outside Loomplane, with the name, region and connection it had, so at the same address. block, the default, refuses the plan until the held repository is in scope. warn lets it through with a warning. Anything that gets a new address is refused either way.",
          "enum": ["block", "warn"]
        }
      }
    },
    "environments": {
      "description": "What each environment declares about itself, by environment name. A release block says how its releases go live.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/environment"
      }
    },
    "federation": {
      "$ref": "#/$defs/federation"
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "$ref": "#/$defs/release"
        }
      }
    },
    "release": {
      "description": "How the environment's releases go live. Version 1 manifests only.",
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "description": "direct deploys all at once, blue_green swaps when the new version is ready, canary moves traffic in steps and checks health at each.",
          "enum": ["direct", "blue_green", "canary"]
        },
        "steps": {
          "description": "Canary only. The traffic percentages to move through, strictly increasing, ending at 100. Defaults to 5, 25, 50, 100.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "hold": {
          "description": "Canary only. How long to watch each step, in whole minutes from 1m to 24h, such as 10m or 1h30m. Defaults to 10m.",
          "type": "string",
          "pattern": "^[0-9]+(?:h|m|h[0-9]+m)$"
        },
        "thresholds": {
          "$ref": "#/$defs/thresholds"
        },
        "min_requests": {
          "description": "The fewest requests a step needs before its health counts. Defaults to 200.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "watch": {
          "description": "How long to watch each release's health after it finishes, in whole minutes up to 24h, such as 15m or 1h. 0 turns the watch off. Defaults to 15m for canary and blue_green, and off for direct. A breach rolls the release back.",
          "type": "string",
          "pattern": "^(?:0|[0-9]+(?:h|m|h[0-9]+m))$"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error_rate": {
          "description": "The highest share of failed requests a step may show, above 0% and at most 100%. Defaults to 1%.",
          "type": "string",
          "pattern": "^(?:100|[0-9]{1,2})(?:\\.[0-9]+)?%$"
        },
        "error_rate_delta": {
          "description": "How far above the current version's failure share a step may be, above 0% and at most 100%. Defaults to 0.5%.",
          "type": "string",
          "pattern": "^(?:100|[0-9]{1,2})(?:\\.[0-9]+)?%$"
        },
        "p95_latency_ratio": {
          "description": "How many times the current version's p95 latency a step may reach, from 1 to 10. Defaults to 1.3.",
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "examples": [
        "postgres",
        "mysql",
        "redis",
        "mongodb",
        "kafka",
        "rabbitmq",
        "nats",
        "object-storage",
        "search",
        "memcached",
        "clickhouse"
      ]
    },
    "provider": {
      "description": "Where it runs, by the provider's name in Loomplane's registry, such as cloud-run, ecs-fargate, vercel or render.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "region": {
      "description": "The provider's region, such as us-central1 or eu-west-1.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "connection": {
      "description": "A connection ID from this organization's infrastructure inventory.",
      "type": "string",
      "pattern": "^conn_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hostname": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
        },
        "ingress_class": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
        },
        "tls_secret": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "build": {
      "description": "Build the approved source on a connected builder, or use a digest-pinned image.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "description": "The build directory from the repository root. Use . for the root itself.",
          "type": "string",
          "pattern": "^(?:\\.|(?!\\.\\.?(?:/|$))[A-Za-z0-9._@+-]+(?:/(?!\\.\\.?(?:/|$))[A-Za-z0-9._@+-]+)*)$"
        },
        "builder": {
          "$ref": "#/$defs/connection"
        },
        "registry": {
          "$ref": "#/$defs/connection"
        },
        "image": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z0-9][a-z0-9.:/_-]*@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "capacity_mode": {
          "description": "Managed workload reservation mode. Guaranteed reserves your reviewed replica maximum; best effort grants no fleet expansion.",
          "enum": ["guaranteed", "best_effort"]
        },
        "cloud_target": {
          "description": "Named target in this environment's assigned Cloud.",
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "cloud_tags": {
          "description": "Select the one target in this environment's assigned Cloud that carries every tag. Can't be set with cloud_target.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          }
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "target": {
          "$ref": "#/$defs/connection"
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "health_path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^/(?!/)[A-Za-z0-9/._~%+-]*$"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "port": {
          "description": "The port the service listens on. Without it, the one its Dockerfile exposes.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "scale": {
          "description": "How many instances run.",
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "size": {
          "description": "What each instance gets.",
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {
              "description": "Virtual CPUs, such as 0.5 or 2.",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 8
            },
            "memory": {
              "description": "MiB.",
              "type": "integer",
              "minimum": 128,
              "maximum": 32768
            },
            "gpu": { "$ref": "#/$defs/gpu" },
            "shm": {
              "description": "MiB of /dev/shm. Counts toward memory.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "public": {
          "description": "Whether the service gets an address on the internet. Without it, yes for anything serving HTTP and no for a worker.",
          "type": "boolean"
        },
        "enabled": {
          "description": "False leaves the service out.",
          "type": "boolean"
        },
        "cloud_sql_network": {
          "description": "VPC and regional subnet for Cloud Run PSC database connections.",
          "$ref": "#/$defs/cloudSQLApplicationNetwork"
        },
        "farp": {
          "$ref": "#/$defs/farp"
        }
      }
    },
    "farp": {
      "description": "Opts the service in to FARP route discovery by an Octopus gateway. An empty block takes Octopus's defaults. An environment's block replaces the service's whole block.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gateway": {
          "description": "The Octopus resource the service feeds. Without it, the manifest's only one.",
          "$ref": "#/$defs/name"
        },
        "openapi": {
          "$ref": "#/$defs/farpPath"
        },
        "asyncapi": {
          "$ref": "#/$defs/farpPath"
        },
        "graphql": {
          "$ref": "#/$defs/farpPath"
        },
        "health": {
          "$ref": "#/$defs/farpPath"
        },
        "metrics": {
          "$ref": "#/$defs/farpPath"
        },
        "grpc_reflection": {
          "type": "boolean"
        },
        "capabilities": {
          "description": "What the service speaks, such as rest or websocket.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          }
        },
        "port": {
          "description": "The port Octopus reaches the service on. Without it, the service's own port.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "enabled": {
          "description": "False opts the service out of FARP, for example in one environment.",
          "type": "boolean"
        }
      }
    },
    "farpPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^/[A-Za-z0-9/._~%+:@!$&'()*,;=-]*$"
    },
    "service": {
      "type": "object",
      "required": ["source"],
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/settings"
        }
      ],
      "properties": {
        "repo": {
          "description": "The alias of the repository the service is in. A project with one repository can leave it out.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "source": {
          "description": "Where the service's code is, as repository analysis found it: a Go main package's directory, a Rust binary's source file, a Node package's, Python project's or JVM module's directory, or a Dockerfile. Prefix the ecosystem (go:, rust:, node:, python:, jvm:, container:) when two have a service at the same path.",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "Corrects what analysis decided the service is.",
          "enum": ["http-service", "web-app", "static-site", "worker"]
        },
        "needs": {
          "description": "Resources and other services this one talks to. Each one it names gets the service its address, in a variable.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "need_options": {
          "description": "Options this service passes to a need, by need and then by option name. A need has to be listed in needs. What a need accepts is checked when you plan.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,31}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          }
        },
        "environments": {
          "description": "Overrides in one environment, by name.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "unevaluatedProperties": false,
            "allOf": [
              {
                "$ref": "#/$defs/settings"
              }
            ]
          }
        }
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource": {
          "description": "A resource in this manifest to use for the dependency.",
          "$ref": "#/$defs/name"
        },
        "external": {
          "description": "A catalog endpoint to connect to instead, by ID.",
          "type": "string",
          "pattern": "^endpoint_[0-9a-z]{26}$"
        },
        "enabled": {
          "description": "Turns an optional dependency on or off. Off can't be set with resource or external.",
          "type": "boolean"
        }
      }
    },
    "gpu": {
      "description": "GPUs on one server or node. Planning checks the kind against the target.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "count": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "resource": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["cloud_sql_psc"]
          },
          "then": {
            "required": ["provider", "version", "region"],
            "properties": {
              "kind": {
                "const": "postgres"
              },
              "provider": {
                "const": "cloud-sql"
              },
              "version": {
                "const": "17"
              }
            }
          }
        }
      ],
      "properties": {
        "gpu": { "$ref": "#/$defs/gpu" },
        "cloud_sql_psc": {
          "description": "Manual PSC endpoint for a PostgreSQL 17 source. You manage the endpoint and DNS. Application attachment is not available yet.",
          "type": "object",
          "required": ["consumer_project", "network", "forwarding_rule"],
          "additionalProperties": false,
          "properties": {
            "consumer_project": {
              "type": "string",
              "minLength": 6
            },
            "network": {
              "type": "string",
              "pattern": "^projects/[^/]+/global/networks/[^/]+$"
            },
            "forwarding_rule": {
              "type": "string",
              "pattern": "^projects/[^/]+/regions/[^/]+/forwardingRules/[^/]+$"
            }
          }
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "target": {
          "type": "string",
          "description": "Checked server connection for a catalog resource."
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "version": {
          "description": "The engine's version, such as \"17\" for Postgres. Without it, the provider chooses.",
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,31}$"
        },
        "gateway": {
          "description": "Put this Postgres resource behind the database gateway. Only postgres resources can.",
          "type": "boolean"
        },
        "uses": {
          "description": "Where a catalog resource gets each dependency, by dependency name: a resource in this manifest, an external endpoint, or on or off for an optional one. A dependency left out gets a new one.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/use"
          }
        },
        "settings": {
          "description": "Values the catalog kind takes, by setting name. The kind says which it has and what each must look like.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "environments": {
          "description": "Overrides in one environment, by name.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gpu": { "$ref": "#/$defs/gpu" },
              "provider": {
                "$ref": "#/$defs/provider"
              },
              "region": {
                "$ref": "#/$defs/region"
              },
              "enabled": {
                "type": "boolean"
              },
              "gateway": {
                "description": "Turn the database gateway on or off for this Postgres resource in this environment. Wins over the resource's own gateway.",
                "type": "boolean"
              },
              "target": {
                "type": "string",
                "description": "The checked server connection this environment runs the resource on. Replaces the resource's target; an environment that changes the provider doesn't keep the resource's."
              },
              "settings": {
                "description": "Settings for this environment. Each one replaces the resource's setting of the same name; the rest come from the resource.",
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 1024
                }
              }
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["routes"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "routes": {
          "description": "Paths and the services they go to. The longest path that matches a request wins, so / catches whatever the others don't.",
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "environments": {
          "description": "Overrides in one environment, by name.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "$ref": "#/$defs/provider"
              },
              "region": {
                "$ref": "#/$defs/region"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["between"],
      "additionalProperties": false,
      "properties": {
        "between": {
          "description": "The two clouds the link joins: gcp and aws.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["gcp", "aws"]
          }
        },
        "region": {
          "$ref": "#/$defs/region",
          "description": "Where the Google Cloud side runs, such as us-central1."
        },
        "environments": {
          "description": "Overrides in one environment, by name.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "region": {
                "$ref": "#/$defs/region"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["path", "to"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "A path prefix, such as /api. It matches /api and anything under /api/.",
          "type": "string",
          "pattern": "^/(?:[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*/?)?$"
        },
        "to": {
          "$ref": "#/$defs/name"
        },
        "strip_prefix": {
          "description": "Remove the path before the request reaches the service, so /api/users arrives as /users.",
          "type": "boolean"
        }
      }
    },
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destinations": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/destinationRef"
          }
        },
        "network_links": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/federationLink"
          }
        },
        "service_exports": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/federationExport"
          }
        },
        "access_grants": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/federationGrant"
          }
        },
        "placements": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/federationPlacement"
          }
        }
      },
      "required": []
    },
    "destinationRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dest_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "environments": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^dest_[0-7][0-9a-hjkmnp-tv-z]{25}$"
          }
        }
      },
      "required": ["id"]
    },
    "federationLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/name"
        },
        "to": {
          "$ref": "#/$defs/name"
        },
        "transport": {
          "enum": ["imported", "ipsec"]
        }
      },
      "required": ["from", "to", "transport"]
    },
    "federationExport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "$ref": "#/$defs/name"
        },
        "destination": {
          "$ref": "#/$defs/name"
        },
        "exposure": {
          "const": "private"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "enum": ["http", "grpc", "tcp"]
        },
        "identity": {
          "enum": ["workload", "gateway"]
        }
      },
      "required": [
        "service",
        "destination",
        "exposure",
        "port",
        "protocol",
        "identity"
      ]
    },
    "federationGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_service": {
          "$ref": "#/$defs/name"
        },
        "source_destination": {
          "$ref": "#/$defs/name"
        },
        "export": {
          "$ref": "#/$defs/name"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "methods": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS",
              "CONNECT",
              "TRACE"
            ]
          }
        },
        "paths": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^/(?!/)[A-Za-z0-9/._~%+-]*$"
          }
        },
        "grpc_methods": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^/[A-Za-z_][A-Za-z0-9_.]*/[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "required": ["source_service", "source_destination", "export"]
    },
    "federationPlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "$ref": "#/$defs/name"
        },
        "destination": {
          "$ref": "#/$defs/name"
        }
      },
      "required": ["service", "destination"]
    },
    "cloudSQLApplicationNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer_project", "network", "subnetwork"],
      "properties": {
        "consumer_project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "network": {
          "type": "string",
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/global/networks/[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "subnetwork": {
          "type": "string",
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/regions/[a-z][a-z0-9-]*/subnetworks/[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "federation": false
        }
      }
    }
  ]
}
