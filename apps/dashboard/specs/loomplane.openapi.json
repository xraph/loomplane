              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitHubInstallation"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/github/installations/{id}": {
      "delete": {
        "operationId": "github.disconnect",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Path parameter: id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "summary": "Disconnect an installation. The App stays installed on GitHub.",
        "tags": [
          "GitHub"
        ],
        "x-forge-entity": {
          "idField": "id",
          "type": "GitHubInstallation"
        }
      }
    },
