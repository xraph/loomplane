{
  "openapi": "3.1.0",
  "info": {
    "title": "Loomplane",
    "description": "Loomplane's API: organizations' projects, environments and infrastructure.",
    "version": "0.1.0-dev"
  },
  "servers": [],
  "paths": {
    "/api/v1/infrastructure": {
      "get": {
        "tags": [
          "Infrastructure"
        ],
        "summary": "What Ctrl Plane can deploy to",
        "operationId": "infrastructure.get",
        "responses": {
          "200": {
            "description": "Infrastructure status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfrastructureStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invitations": {
      "get": {
        "tags": [
          "Members",
          "Identity"
        ],
        "summary": "Invitations nobody has accepted yet",
        "operationId": "invitations.list",
        "responses": {
          "200": {
            "description": "Pending invitations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgInvitationList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "invitations.create",
        "requestBody": {
          "description": "Request body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The invitation and its link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedInvitation"
                }
              }
            }
          }
        },
        "summary": "Invite someone by email and get the link that lets them join",
        "tags": [
          "Members",
          "Identity"
        ],
        "x-forge-invalidates": [
          "OrgInvitation[]"
        ],
        "x-forge-no-entity": true
      }
    },
    "/api/v1/members": {
      "get": {
        "tags": [
          "Members",
          "Identity"
        ],
        "summary": "The organization's members, with their names and emails",
        "operationId": "members.list",
        "responses": {
          "200": {
            "description": "Members",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgMemberList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "The organization's projects, newest first",
        "operationId": "projects.list",
        "responses": {
          "200": {
            "description": "Projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Create a project and start initializing it",
        "operationId": "projects.create",
        "requestBody": {
          "description": "Request body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The new project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "One project",
        "operationId": "projects.get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Path parameter: id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "projects.delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Path parameter: id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "summary": "Delete a project and its environments",
        "tags": [
          "Projects"
        ],
        "x-forge-entity": {
          "idField": "id",
          "type": "Project"
        }
      },
      "patch": {
        "tags": [
          "Projects"
        ],
        "summary": "Change a project's name, description or repository",
        "operationId": "projects.update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Path parameter: id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Request body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProjectInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}/environments": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "A project's environments",
        "operationId": "environments.list",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Path parameter: id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Environments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public-config": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "Settings the dashboard needs before sign-in",
        "operationId": "publicConfig.get",
        "responses": {
          "200": {
            "description": "Public settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "The signed-in user, their active organization and their permissions in it",
        "operationId": "session.get",
        "responses": {
          "200": {
            "description": "The session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateInvitationInputBody": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "CreateProjectInputBody": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repository_url": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "CreatedInvitation": {
        "type": "object",
        "required": [
          "invitation",
          "accept_path"
        ],
        "properties": {
          "accept_path": {
            "type": "string"
          },
          "invitation": {
            "$ref": "#/components/schemas/OrgInvitation"
          }
        }
      },
      "Environment": {
        "type": "object",
        "required": [
          "id",
          "org_id",
          "project_id",
          "name",
          "kind",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "x-forge-id": true
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "org_id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EnvironmentList": {
        "properties": {
          "environments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Environment"
            }
          }
        },
        "required": [
          "environments"
        ],
        "type": "object",
        "x-forge-envelope": "environments"
      },
      "InfrastructureStatus": {
        "type": "object",
        "required": [
          "engine",
          "store",
          "providers"
        ],
        "properties": {
          "engine": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            }
          },
          "store": {
            "type": "string"
          }
        }
      },
      "OrgInvitation": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "invited_by",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "x-forge-id": true
          },
          "invited_by": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "OrgInvitationList": {
        "properties": {
          "invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgInvitation"
            }
          }
        },
        "required": [
          "invitations"
        ],
        "type": "object",
        "x-forge-envelope": "invitations"
      },
      "OrgMember": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "email",
          "name",
          "role",
          "member_role",
          "joined_at"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "x-forge-id": true
          },
          "joined_at": {
            "type": "string",
            "format": "date-time"
          },
          "member_role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      },
      "OrgMemberList": {
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgMember"
            }
          }
        },
        "required": [
          "members"
        ],
        "type": "object",
        "x-forge-envelope": "members"
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "org_id",
          "name",
          "slug",
          "description",
          "repository_url",
          "status",
          "created_by",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "x-forge-id": true
          },
          "name": {
            "type": "string"
          },
          "org_id": {
            "type": "string"
          },
          "repository_url": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectList": {
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          }
        },
        "required": [
          "projects"
        ],
        "type": "object",
        "x-forge-envelope": "projects"
      },
      "ProviderStatus": {
        "type": "object",
        "required": [
          "name",
          "version",
          "region",
          "capabilities"
        ],
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "PublicConfig": {
        "type": "object",
        "required": [
          "publishable_key",
          "app_id",
          "auth_base_path"
        ],
        "properties": {
          "app_id": {
            "type": "string"
          },
          "auth_base_path": {
            "type": "string"
          },
          "publishable_key": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "user_id",
          "org_id",
          "permissions"
        ],
        "properties": {
          "org_id": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "user_id": {
            "type": "string"
          }
        }
      },
      "UpdateProjectInputBody": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "repository_url": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "description": "An authsome session token, sent as a bearer token.",
        "scheme": "bearer"
      }
    }
  }
}
