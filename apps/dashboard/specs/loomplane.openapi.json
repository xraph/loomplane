  "components": {
    "schemas": {
      "Analysis": {
        "type": "object",
        "required": [
          "id",
          "org_id",
          "project_id",
          "status",
          "repository",
          "ref",
          "commit_sha",
          "error",
          "summary",
          "created_by",
          "created_at"
        ],
        "properties": {
          "commit_sha": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "x-forge-id": true
          },
          "org_id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          }
        }
      },
      "AnalysisGraph": {
        "type": "object",
        "required": [
          "id",
          "graph"
        ],
        "properties": {
          "graph": {
            "$ref": "#/components/schemas/Graph"
          },
          "id": {
            "type": "string",
            "x-forge-id": true
          }
        }
      },
      "AnalysisList": {
        "properties": {
          "analyses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Analysis"
            }
          }
        },
        "required": [
          "analyses"
        ],
        "type": "object",
        "x-forge-envelope": "analyses"
      },
      "BuildSystem": {
        "type": "object",
        "required": [
          "name",
          "path",
          "evidence"
        ],
        "properties": {
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "Commands": {
        "type": "object",
        "properties": {
          "build": {
            "type": "string"
          },
          "dev": {
            "type": "string"
          },
          "start": {
            "type": "string"
          }
        }
      },
      "ConnectGitHubInputBody": {
        "type": "object",
        "required": [
          "installation_id",
          "code",
          "state"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "installation_id": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "ConnectedRepository": {
        "type": "object",
        "required": [
          "full_name",
          "private",
          "default_branch",
          "url",
          "installation"
        ],
        "properties": {
          "default_branch": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "installation": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "ConnectedRepositoryList": {
        "type": "object",
        "required": [
          "repositories"
        ],
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectedRepository"
            }
          }
        }
      },
      "CreateEnvironmentInputBody": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateInvitationInputBody": {
        "type": "object",
        "required": [
          "email"
