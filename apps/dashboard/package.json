{
  "name": "@loomplane/dashboard",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm routes:generate && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "pnpm routes:generate && tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:specs": "curl -fsS ${LOOMPLANE_API_URL:-http://localhost:8780}/openapi.json | node scripts/loomplane-spec.mjs && curl -fsS ${LOOMPLANE_API_URL:-http://localhost:8780}/asyncapi.json | node scripts/loomplane-stream-spec.mjs && node scripts/authsome-spec.mjs",
    "gen:client": "forge client generate",
    "check:client": "forge client check",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@authsome/ui-components": "1.7.2",
    "@authsome/ui-core": "1.7.2",
    "@authsome/ui-react": "1.7.2",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@forge-go/client-core": "1.13.0",
    "@forge-go/client-react": "1.13.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "1.170.42",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tanstack/router-cli": "1.167.41",
    "@tanstack/router-plugin": "1.168.43",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.3"
  },
  "description": "The Loomplane dashboard, served by the Loomplane Forge app.",
  "packageManager": "pnpm@11.5.0"
}
